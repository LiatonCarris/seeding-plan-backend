# Local paths only. Never put token/key contents in this file.
SEEDING_DATABASE_PATH=./runtime/seeding.sqlite3
SEEDING_OPERATOR_AUTH_FILE=./secrets/operators.json
SEEDING_GRANT_SIGNING_KEY_FILE=./secrets/grant-signing.key
JUGUANG_ACCESS_TOKEN_FILE=./secrets/juguang-access-token
SEEDING_ALERT_WEBHOOK_FILE=./secrets/alert-webhook-url

# Write adapters are intentionally not enabled by environment variables.
# Test execution, production paused-create, account relock, spend monitoring,
# and production release must be injected as audited adapters by deployment.
